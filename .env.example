# Supabase Configuration
# Obtén estas credenciales en: https://supabase.com -> Tu Proyecto -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Compatibilidad temporal:
VITE_SUPABASE_ANON_KEY=your-anon-key

# Google Gemini AI (Generación de rutinas desde texto)
# Obtén tu API Key gratuita en: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your-gemini-api-key

# App Information
VITE_APP_NAME=RoutinUP